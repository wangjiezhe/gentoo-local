From a24f7ac256e37e99953a687c192c8704969cc15d Mon Sep 17 00:00:00 2001
From: Lei Zhang <antiagainst@gmail.com>
Date: Sat, 27 Jun 2026 02:11:14 +0000
Subject: [PATCH 3/3] Fix AMDGCN target triple test matching

LLVM now prints the AMDGCN target triple with an explicit unknown environment, for example amdgcn-amd-amdhsa-unknown-gfx942 instead of the previous amdgcn-amd-amdhsa--gfx942 spelling.

Keep the tests focused on the gfx target by accepting any environment component while still asserting the requested architecture.
---
 python/test/unit/language/test_core.py | 2 +-
 python/test/unit/tools/test_aot.py     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/python/test/unit/language/test_core.py b/python/test/unit/language/test_core.py
index 1cd30e076c41..6a7753552024 100644
--- a/python/test/unit/language/test_core.py
+++ b/python/test/unit/language/test_core.py
@@ -6319,7 +6319,7 @@ def simple(data, out):
             h = simple.warmup(data, out, arch=arch, grid=(1, ))
         ttgir_gfx = re.search(r'hip:(\w+)', h.asm["ttgir"])
         ttgir_warp = re.search(r'"ttg.threads-per-warp" = (\d+)', h.asm["ttgir"])
-        amdgcn_gfx = re.search(r'.amdgcn_target "amdgcn-amd-amdhsa--(\w+)"', h.asm["amdgcn"])
+        amdgcn_gfx = re.search(r'\.amdgcn_target "amdgcn-amd-amdhsa-[^-]*-(\w+)"', h.asm["amdgcn"])
         assert ttgir_gfx.group(1) == arch
         assert int(ttgir_warp.group(1)) == (32 if arch == "gfx1200" else 64)
         assert amdgcn_gfx.group(1) == arch
diff --git a/python/test/unit/tools/test_aot.py b/python/test/unit/tools/test_aot.py
index 320f2434f842..ff03c206dd95 100644
--- a/python/test/unit/tools/test_aot.py
+++ b/python/test/unit/tools/test_aot.py
@@ -562,7 +562,7 @@ def test_ttgir_to_asm():
             assert ".address_size 64" in ptx
         elif is_hip():
             amdgcn = k.asm["amdgcn"]
-            assert '.amdgcn_target "amdgcn-amd-amdhsa--gfx942"' in amdgcn
+            assert re.search(r'\.amdgcn_target "amdgcn-amd-amdhsa-[^-]*-gfx942"', amdgcn)
             assert '.wavefront_size: 64' in amdgcn
 
 
