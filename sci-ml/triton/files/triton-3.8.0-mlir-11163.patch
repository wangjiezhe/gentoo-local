-  // CHECK: llvm.insertelement %[[C0]], %[[G0:.*]][%{{.*}} : i32] : vector<4xi32>
-  // CHECK: "llvm.amdgcn.tensor.load.to.lds"
+  // CHECK: %[[G0_C0:.*]] = llvm.insertelement %[[C0]], %{{.*}}[%{{.*}} : i32] : vector<4xi32>
